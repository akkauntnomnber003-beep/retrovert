; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="RatRovert"
config/description="Top-down mobile roguelite inspired by The Binding of Isaac."
config/version="1.0.0"
run/main_scene="res://scenes/ui/MainMenu.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.png"
boot_splash/bg_color=Color(0.07, 0.05, 0.04, 1)
boot_splash/show_image=false
boot_splash/fullsize=true

[autoload]

GameState="*res://scripts/autoloads/GameState.gd"
EventBus="*res://scripts/autoloads/EventBus.gd"
ChatLog="*res://scripts/autoloads/ChatLog.gd"
RoomGen="*res://scripts/autoloads/RoomGen.gd"
AudioManager="*res://scripts/autoloads/AudioManager.gd"
SaveManager="*res://scripts/autoloads/SaveManager.gd"
BulletPool="*res://scripts/autoloads/BulletPool.gd"
ItemDatabase="*res://scripts/autoloads/ItemDatabase.gd"
ModAPI="*res://scripts/autoloads/ModAPI.gd"
ModLoader="*res://scripts/autoloads/ModLoader.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=3
window/size/initial_position_type=4
window/handheld/orientation=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/per_pixel_transparency/allowed=false
window/vsync/vsync_mode=1

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=true

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="enemy"
2d_physics/layer_4="player_bullet"
2d_physics/layer_5="enemy_bullet"
2d_physics/layer_6="pickup"
2d_physics/layer_7="wall"
2d_physics/layer_8="door"

[physics]

2d/default_gravity=0.0
common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=8
common/physics_jitter_fix=0.5

[rendering]

textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=false
2d/snap/snap_2d_vertices_to_pixel=false
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.07, 0.05, 0.04, 1)
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_2d=0

[input]

